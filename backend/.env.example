APP_STAGE=dev
APP_VERSION=dev
DEBUG=true
LOG_LEVEL=INFO
SQL_ECHO=false

API_HOST=0.0.0.0
API_PORT=8080

# The Vite dev server and any deployed frontend origin.
CORS_ALLOW_ORIGINS=http://localhost:3000,http://localhost:5173
CORS_ALLOW_ORIGIN_REGEX=

DATABASE_URL=postgresql+asyncpg://postgres:secret@localhost:5432/orbitguard
REDIS_URL=redis://localhost:6379/0

# Official case scenarios loaded on startup. Path is relative to the repo root
# when running locally; the image overrides it to /app/data.
SCENARIO_SEED_DIR=../data
SCENARIO_SEED_ENABLED=true

# Guard rails for scenarios uploaded by the jury.
MAX_SCENARIO_BYTES=8388608
MAX_SIMULATION_STEPS=5000
MAX_SATELLITES=500

# Blank lets the process pools size themselves to the host.
ANALYSIS_MAX_WORKERS=
OPTIMIZER_MAX_WORKERS=
