# Copy to .env before `docker compose up`.
APP_STAGE=dev
APP_VERSION=dev
DEBUG=true
LOG_LEVEL=INFO

BACKEND_PORT=8080

POSTGRES_USER=postgres
POSTGRES_PASSWORD=secret
POSTGRES_DB=orbitguard

# Origins allowed to call the API — the Vite dev server plus any deployed frontend.
CORS_ALLOW_ORIGINS=http://localhost:3000,http://localhost:5173
CORS_ALLOW_ORIGIN_REGEX=

SCENARIO_SEED_ENABLED=true
MAX_SCENARIO_BYTES=8388608
MAX_SIMULATION_STEPS=8640
MAX_SATELLITES=500
